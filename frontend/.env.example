# API Base URL
# The base URL for backend API calls
# Default: /api (relative to current domain)
VITE_API_BASE=/api

# Example for development with different backend port
# VITE_API_BASE=http://localhost:8090/api

# Example for production
# VITE_API_BASE=https://api.example.com

# Site Configuration
# VITE_SITE_TITLE=Sakura Theme
# VITE_SITE_URL=https://example.com
